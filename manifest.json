{
  "manifest_version": 3,
  "name": "Snow X Assistant",
  "version": "0.7.5",
  "description": "在 X 上用统一标签显示粉丝数、质量标签、单条推文流速和 AI 文本检测,并提供可独立开关的互关清理。本地运行,不额外请求 X API。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Snow X Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "lib/i18n.js",
        "lib/parse.js",
        "lib/common.js",
        "lib/aitext.js",
        "lib/badge.js",
        "content.js",
        "following.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
